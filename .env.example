# Environment
NODE_ENV=development

# Local PostgreSQL. Adjust the credentials if your cluster differs.
DATABASE_URL="postgresql://postgres@127.0.0.1:5432/livn?schema=public"

# Signs session cookies. Generate a long random value; changing it invalidates
# every active session.
SESSION_SECRET="change-me-generate-a-long-random-string-at-least-32-bytes"

# Attachment storage. Local filesystem by default.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./.data/uploads"

APP_URL="http://localhost:3777"
